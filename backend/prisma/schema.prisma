generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              UserRole  @default(STUDENT)
  phone             String?
  bio               String?
  title             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  studentProgress   StudentProgress?
  bookings          Booking[]
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  instructorSlots   AvailabilitySlot[] @relation("InstructorSlots")
  feedbackGiven     Feedback[] @relation("FeedbackAuthor")
  payments          Payment[]
  quizAttempts      QuizAttempt[]

  @@index([email])
  @@index([role])
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model StudentProgress {
  id                String    @id @default(cuid())
  studentId         String    @unique
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  track             LicenseTrack @default(CODE_8)
  progressPct       Int       @default(0)
  rating            Float     @default(0.0)
  lessonNotes       String?
  completedLessons  Int       @default(0)
  totalLessons      Int       @default(20)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  feedbackReceived  Feedback[] @relation("StudentFeedback")

  @@index([studentId])
}

enum LicenseTrack {
  CODE_8
  CODE_10
}

model AvailabilitySlot {
  id                String    @id @default(cuid())
  instructorId      String
  instructor        User      @relation("InstructorSlots", fields: [instructorId], references: [id], onDelete: Cascade)

  date              String    // YYYY-MM-DD
  timeWindow        String    // HH:MM format
  vehicle           String
  vehicleId         String?

  isBooked          Boolean   @default(false)
  studentId         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  booking           Booking?

  @@unique([instructorId, date, timeWindow, vehicleId])
  @@index([instructorId])
  @@index([date])
  @@index([isBooked])
}

model Booking {
  id                String    @id @default(cuid())
  slotId            String    @unique
  slot              AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  studentId         String
  status            BookingStatus @default(CONFIRMED)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Payment {
  id                String    @id @default(cuid())
  studentId         String
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  amount            Float
  status            PaymentStatus @default(PENDING)
  packageType       String    // "single", "starter", "pro", "full"
  lessonsIncluded   Int

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Message {
  id                String    @id @default(cuid())
  senderId          String
  sender            User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId        String
  receiver          User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  content           String
  isRead            Boolean   @default(false)

  createdAt         DateTime  @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Feedback {
  id                String    @id @default(cuid())
  studentId         String
  student           StudentProgress @relation("StudentFeedback", fields: [studentId], references: [id], onDelete: Cascade)

  authorId          String
  author            User      @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  ratingScore       Int       // 1-5
  evaluationNotes   String

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([studentId])
  @@index([authorId])
}

model QuizAttempt {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseCode       String    // "8" or "10"
  score             Int
  total             Int
  percentScore      Float
  passed            Boolean
  answers           String    // JSON array

  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  type              String    // "booking_confirmed", "lesson_reminder", etc.
  title             String
  message           String
  isRead            Boolean   @default(false)
  relatedId         String?   // e.g., bookingId for linked resources

  createdAt         DateTime  @default(now())
}

